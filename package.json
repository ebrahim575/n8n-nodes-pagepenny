{
  "name": "n8n-nodes-pagepenny",
  "version": "0.1.0",
  "description": "n8n node for PagePenny: render PDFs and images from templates or HTML, one cent per render",
  "license": "MIT",
  "homepage": "https://pagepenny.com",
  "keywords": [
    "n8n-community-node-package",
    "pdf",
    "pdf-generation",
    "invoice",
    "image-generation",
    "html-to-pdf",
    "pagepenny"
  ],
  "author": {
    "name": "Ebrahim Zulqarni",
    "email": "72365795+ebrahim575@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebrahim575/n8n-nodes-pagepenny.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PagePennyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PagePenny/PagePenny.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
